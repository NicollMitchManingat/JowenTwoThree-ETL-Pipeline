# Supabase source database (Stage 1 extraction)
# Project Settings -> Database in the Supabase dashboard.
# Use the session pooler host (port 5432) if direct IPv6 is unavailable.
# Port 6543 is the transaction pooler and does not keep session settings.
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your_project_ref
SUPABASE_DB_PASSWORD=your_password_here
SUPABASE_DB_SSLMODE=require

# Force the extraction session into read-only mode.
SUPABASE_READ_ONLY=true

# Pipeline behaviour
# true = use deterministic sample data, no database connection required
ETL_MOCK_MODE=true

# Business timezone used to compute the previous-business-day window
ETL_TIMEZONE=Asia/Manila

# Local staging and log locations (gitignored)
ETL_STAGING_DIR=data/bronze
ETL_LOG_DIR=data/logs
ETL_HANDOVER_DIR=data/handover

# Stage 2 transformation output and behaviour
ETL_SILVER_DIR=data/silver
ETL_QUARANTINE_DIR=data/quarantine
ETL_TRANSFORM_LOG_DIR=data/logs/transformation
ETL_LOOKBACK_DAYS=3
ETL_LOW_STOCK_THRESHOLD=5
ETL_REJECTION_WARN_RATE=0.01
ETL_REJECTION_FAIL_RATE=0.05

# Retry behaviour for transient connection failures
ETL_RETRY_ATTEMPTS=3
ETL_RETRY_BACKOFF_SECONDS=2

# Logging
LOG_LEVEL=INFO
ETL_LOG_RETENTION_DAYS=90

# Separate LOCAL warehouse; never use operational Supabase credentials here.
WAREHOUSE_DB_HOST=127.0.0.1
WAREHOUSE_DB_PORT=55432
WAREHOUSE_DB_NAME=jowen_analytics
WAREHOUSE_DB_USER=jowen_etl_local
WAREHOUSE_DB_PASSWORD=
WAREHOUSE_STORAGE_PATH=data/warehouse
WAREHOUSE_MINIMUM_FREE_BYTES=1073741824
WAREHOUSE_ALLOW_DEMO=false
